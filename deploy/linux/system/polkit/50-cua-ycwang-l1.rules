// L1 Polkit rule for cua-ycwang: allow active local users in sudo/wheel/input
// to run scoped cua-elevated-helper actions with admin_keep caching.
polkit.addRule(function(action, subject) {
    if (action.id === "io.github.yuchengwang.cua.uinput.setup" ||
        action.id === "io.github.yuchengwang.cua.helper.verify") {
        if (subject.local && subject.active &&
            (subject.isInGroup("sudo") || subject.isInGroup("wheel") || subject.isInGroup("input"))) {
            return polkit.Result.AUTH_ADMIN_KEEP;
        }
    }
});
